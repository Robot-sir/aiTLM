PORT=5000
FRONTEND_URL=http://localhost:5173

# OpenCode Go/Zen — OpenAI-compatible LLM provider (voice agent + chat)
# Base URL is fixed: https://opencode.ai/zen/v1
# Model is fixed in the agent: mimo-v2.5-free
# Get a key from https://opencode.ai
OPENCODE_API_KEY=

# LiveKit
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_URL=

# Hardware bridge
ESP32_WS_PORT=8787
CLASSROOM_BRIDGE_URL=ws://127.0.0.1:8787
ESP32_DEVICE_ID=kite-classroom-01

# ⚠️  CRITICAL: This token MUST match the token in your ESP32 firmware.
# The ESP32 firmware default is "abc".
# If this env var is EMPTY or missing, auth is bypassed (any device can connect).
# If this env var is SET, the ESP32 must send the EXACT same value.
ESP32_DEVICE_TOKEN=abc
